{
  "name": "Hedge's Bestiary",
  "landing_text": "A compendium of the wild and fantastical beasts that now roam your world!",
  "version": 1,
  "creative_tab": "hedges_bestiary:hedges_bestiary_tab",
  "use_resource_pack": true,
  "book_texture": "hedges_bestiary:textures/gui/book/book.png",
  "model": "hedges_bestiary:hedges_bestiary",
  "macros": {
    "$(finemilk)": "$(l:hedges_bestiary:items/treats#treat2)fine milk$(/l)",
    "$(richmilk)": "$(l:hedges_bestiary:items/treats#treat2)rich milk$(/l)",

    "$(treat0)": "$(l:hedges_bestiary:items/treats#treat1)plain treat$(/l)",
    "$(treat1)": "$(l:hedges_bestiary:items/treats#treat2)seasoned treat$(/l)",
    "$(treat2)": "$(l:hedges_bestiary:items/treats#treat3)hearty treat$(/l)",
    "$(treat3)": "$(l:hedges_bestiary:items/treats#treat3)luscious treat$(/l)",

    "$(ability)": "$(k:hedges_bestiary.mountSpecialKey)"
  }
}